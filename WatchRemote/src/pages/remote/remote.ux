<template>
  <div class="page">
    <div class="hd">
      <text class="hdTitle">手表遥控</text>
      <div class="hdRight">
        <text class="hdSub">{{connTx}}</text>
        <text class="quit" onclick="exitApp">退出</text>
      </div>
    </div>

    <div class="pad" ontouchstart="ts" ontouchend="te">
      <text class="padTx">在这里滑动</text>
      <text class="padSub">上滑下翻 · 下滑上翻 · 左右滑翻页 · 点一下=点手机屏幕</text>
      <text class="padDir">{{dirTx}}</text>
    </div>

    <div class="grid">
      <div class="gBtn" onclick="sendUp">
        <text class="gTx">下翻</text>
      </div>
      <div class="gBtn" onclick="sendDown">
        <text class="gTx">上翻</text>
      </div>
      <div class="gBtn" onclick="sendLeft">
        <text class="gTx">返回</text>
      </div>
      <div class="gBtn" onclick="sendRight">
        <text class="gTx">下一页</text>
      </div>
    </div>

    <div class="toast" if="{{toastOn}}">
      <text class="toastText">{{tx}}</text>
    </div>
  </div>
</template>

<style>
  .page { width:432px; height:514px; background-color:#0E1214; padding:14px 16px; flex-direction:column; }
  .hd { height:44px; flex-direction:row; align-items:center; justify-content:space-between; }
  .hdTitle { font-size:26px; color:#F2F5F7; font-weight:bold; }
  .hdRight { flex-direction:row; align-items:center; }
  .hdSub { font-size:13px; color:#7C8A92; margin-right:12px; }
  .quit { font-size:14px; color:#F0A35E; }
  .pad { flex:1; margin-top:10px; background-color:#141A1E; border-radius:18px; border-width:1px; border-color:#1E2A31; flex-direction:column; justify-content:center; align-items:center; }
  .padTx { font-size:20px; color:#E8EEF1; font-weight:bold; }
  .padSub { font-size:13px; color:#7C8A92; margin-top:8px; }
  .padDir { font-size:15px; color:#5BD6A2; margin-top:10px; font-weight:bold; }
  .grid { flex-direction:row; margin-top:12px; }
  .gBtn { flex:1; height:46px; margin-right:8px; background-color:#1E2A31; border-radius:14px; justify-content:center; align-items:center; }
  .gLast { margin-right:0; }
  .gTx { font-size:16px; color:#FFFFFF; }
  .toast { position:absolute; left:96px; right:96px; bottom:64px; height:44px; background-color:#1E2A31; border-radius:22px; justify-content:center; align-items:center; }
  .toastText { font-size:16px; color:#E8EEF1; }
</style>

<script>
import interconnect from '@system.interconnect'
import vibrator from '@system.vibrator'

export default {
  data: {
    dirTx: '滑动试试',
    tx: '',
    toastOn: false,
    connTx: '未连接手机',
    sx: 0,
    sy: 0
  },

  onInit() {
    const that = this
    try {
      this.conn = interconnect.instance()
      this.conn.onopen = function () { that.connTx = '已连接手机' }
      this.conn.onclose = function () { that.connTx = '未连接手机' }
      this.conn.onerror = function () { that.connTx = '连接出错' }
    } catch (e) {
      this.conn = null
      this.connTx = '通道不可用'
    }
  },

  // 右滑/返回键不再让快应用退出：一律自己吃掉，返回由手机执行
  onBackPress() {
    // 手表系统会把「从边缘往右滑」变成返回事件，这里补发一条右滑指令
    const now = Date.now()
    // 正常触摸已经发出指令了就别再补一条，免得滑两次
    if (now - (this.lastSend || 0) > 600 && this.lastTouch && now - this.lastTouch < 900) {
      this.send('right')
    }
    return true
  },

  exitApp() {
    try { this.$app.exit() } catch (e) {}
  },

  onShow() {
    if (this.conn && typeof this.conn.isConnected === 'function') {
      try { this.connTx = this.conn.isConnected() ? '已连接手机' : '未连接手机' } catch (e) {}
    }
  },

  ts(e) {
    const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
    if (t) { this.sx = t.pageX || t.clientX || 0; this.sy = t.pageY || t.clientY || 0 }
  },

  te(e) {
    const t = (e.changedTouches && e.changedTouches[0]) || (e.touches && e.touches[0])
    if (!t) return
    const px = t.pageX !== undefined ? t.pageX : (t.clientX || 0)
    const py = t.pageY !== undefined ? t.pageY : (t.clientY || 0)
    this.lastTouch = Date.now()
    const dx = px - this.sx
    const dy = py - this.sy
    // 手表页面 432 x 514，换算成 0~1 的比例，交给手机按屏幕尺寸还原
    const nx1 = this.sx / 432
    const ny1 = this.sy / 514
    const nx2 = px / 432
    const ny2 = py / 514
    if (Math.abs(dx) < 18 && Math.abs(dy) < 18) {
      this.sendPoint('tap', nx1, ny1, nx1, ny1, '点按')
      return
    }
    this.sendPoint('swipe', nx1, ny1, nx2, ny2, Math.abs(dy) >= Math.abs(dx) ? (dy < 0 ? '上滑' : '下滑') : (dx < 0 ? '左滑' : '右滑'))
  },

  tap() { this.send('click') },

  sendUp() { this.send('up') },
  sendDown() { this.send('down') },
  sendLeft() { this.send('back') },
  sendRight() { this.send('right') },

  sendPoint(kind, nx1, ny1, nx2, ny2, label) {
    this.dirTx = label
    this.lastSend = Date.now()
    if (!this.conn) { this.tip('没有连接通道'); return }
    const that = this
    try {
      this.conn.send({
        data: { tag: 'remote', act: kind, nx1: nx1, ny1: ny1, nx2: nx2, ny2: ny2 },
        success: function () { that.tip('已发送：' + label) },
        fail: function () { that.tip('发送失败，检查手机端是否连上') }
      })
    } catch (e) { this.tip('发送失败') }
    try { vibrator.vibrate({ mode: 'short' }) } catch (e) {}
  },

  send(act) {
    this.lastSend = Date.now()
    const names = { up: '下翻', down: '上翻', left: '左滑', right: '右滑', click: '点击', back: '返回' }
    this.dirTx = names[act] || act
    if (!this.conn) { this.tip('没有连接通道'); return }
    const that = this
    try {
      this.conn.send({
        data: { tag: 'remote', act: act },
        success: function () { that.tip('已发送：' + (names[act] || act)) },
        fail: function () { that.tip('发送失败，检查手机端是否连上') }
      })
    } catch (e) { this.tip('发送失败') }
    try { vibrator.vibrate({ mode: 'short' }) } catch (e) {}
  },

  tip(m) {
    this.tx = m; this.toastOn = true
    const that = this
    if (this.t) clearTimeout(this.t)
    this.t = setTimeout(function () { that.toastOn = false }, 1400)
  }
}
</script>
