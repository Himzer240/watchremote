<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3FF"
    android:tag="pageBg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💊"
        android:textSize="42sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="该吃药了"
        android:textColor="@color/primary"
        android:tag="accentText"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="药品名"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="每次 1片 · 饭后"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="08:00"
        android:textColor="@color/sub"
        android:textSize="14sp" />

    <Button
            android:stateListAnimator="@null"
            android:elevation="0dp"
        android:id="@+id/btnTaken"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_btn_primary"
        android:tag="accentBg"
        android:text="✓  已服用"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <Button
            android:stateListAnimator="@null"
            android:elevation="0dp"
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_ghost"
        android:text="10 分钟后再提醒"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <Button
            android:stateListAnimator="@null"
            android:elevation="0dp"
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:text="先关掉"
        android:textAllCaps="false"
        android:textColor="@color/sub"
        android:textSize="14sp" />
</LinearLayout>
